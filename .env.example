# Generate once with: python -m tuoming_agent.keygen
MASKING_MASTER_KEY=
MASKING_KEY_VERSION=1
TUOMING_DATA_DIR=.tuoming-data
TUOMING_DEFAULT_TENANT=local-user

# Optional: required only for natural-language analysis planning.
ANALYST_API_KEY=
ANALYST_BASE_URL=https://api.deepseek.com
ANALYST_MODEL_NAME=deepseek-chat
ANALYSIS_MAX_REPAIR_ATTEMPTS=3

# Per-task DuckDB safety limits. Values above these defaults are rejected.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
DUCKDB_MAX_TEMP_DIRECTORY_SIZE=4GB
